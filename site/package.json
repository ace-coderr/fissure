{
  "name": "fissure-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Fissure project site. Every number on it comes from the repository's own test output (npm run data).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
