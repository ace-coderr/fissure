//! The sequence runner: deploy the target, apply random calls, check
//! invariants after every call.
//!
//! Effects are explicit: everything that touches the chain declares
//! `uses (evm: mut Evm)`; the randomness is a plain value (`Prng`) threaded by
//! `mut`, never ambient state.

use core::ptr::MemVec
use ingot::cast::Cast
use ingot::gen::Env
use ingot::menu::{Menu, Step}
use ingot::prng::{Draw, Prng}
use std::evm::effects::revert_error

/// What the user supplies: how to deploy the contract under test, the menu of
/// calls, and the invariants. `check` returns 0 when every invariant holds, or
/// the 1-based id of the first one that does not.
pub trait Harness {
    type Calls: Menu

    fn deploy(_ salt: u256) -> Address uses (evm: mut Evm)
    fn check(_ target: Address) -> u256 uses (evm: mut Evm)

    /// What generators such as `Amount` treat as the target's "current
    /// balance". Defaults to its native balance; a token overrides it with a
    /// token balance. Read the target's own state only.
    fn aim(_ target: Address) -> u256 uses (evm: mut Evm) {
        evm.balance(target).as_wei()
    }

    /// Words describing the target's state, taken before every call and handed
    /// to `check_step` afterwards. Defaults to nothing.
    fn snapshot(_ target: Address) -> MemVec<u256> uses (evm: mut Evm) {
        MemVec<u256>::new()
    }

    /// A property of one transition: called after every call with the state
    /// from before it, the call, and whether the callee accepted it. Returns 0
    /// if it holds, otherwise an invariant id (distinct from `check`'s ids).
    fn check_step(_ target: Address, _ before: MemVec<u256>, _ step: Step, _ accepted: bool) -> u256
    uses (evm: mut Evm)
    {
        0
    }

    // Multi-sender variants of the hooks. The defaults call the single-sender
    // hooks above, so a harness that never uses a `Cast` ignores these. A
    // multi-sender harness overrides them to see the cast's addresses.

    /// `aim`, for the account `sender` that is about to make a call.
    fn aim_with(_ target: Address, _ sender: u256) -> u256 uses (evm: mut Evm) {
        Self::aim(target)
    }

    fn snapshot_with(_ target: Address, _ cast: Cast) -> MemVec<u256>
    uses (evm: mut Evm)
    {
        Self::snapshot(target)
    }

    fn check_step_with(
        _ target: Address,
        _ cast: Cast,
        _ before: MemVec<u256>,
        _ step: Step,
        _ accepted: bool,
    ) -> u256
    uses (evm: mut Evm)
    {
        Self::check_step(target, before, step, accepted)
    }

    fn check_with(_ target: Address, _ cast: Cast) -> u256 uses (evm: mut Evm) {
        Self::check(target)
    }
}

pub struct Config {
    /// Everything is derived from this value: same seed, same run.
    pub seed: u256,
    /// Number of calls to make.
    pub steps: u256,
    /// Gas forwarded to each call.
    pub gas: u256,
}

/// The result of one run.
pub struct Run {
    /// 0 when all invariants held; otherwise the id of the one that broke.
    pub broken: u256,
    /// Index (0-based) of the call after which the invariant broke.
    pub at: u256,
    /// Calls made.
    pub executed: u256,
    /// Calls the callee accepted (did not revert).
    pub accepted: u256,
    /// Per menu entry: calls made.
    pub calls: MemVec<u256>,
    /// Per menu entry: calls accepted.
    pub ok: MemVec<u256>,
    /// Every call made, in order.
    pub steps: MemVec<Step>,
}

#[error]
pub struct EmptyMenu {}

/// Raised when an invariant breaks: the seed reproduces the run and `at` is the
/// call that exposed it.
#[error]
pub struct InvariantBroken { pub seed: u256, pub at: u256, pub invariant: u256 }

/// The sender cannot afford the run: calls that attach value would fail for
/// lack of funds, so results would depend on how much earlier runs spent.
/// Give the test a bigger `balance`.
#[error]
pub struct Underfunded { pub have: u256, pub need: u256 }

/// The test is running out of gas, and with it the room to deploy and call.
/// `fe test` gives a test a fixed gas budget (memory counts: Fe never frees it),
/// and unoptimised builds spend it faster. Lower `steps` or the number of runs.
#[error]
pub struct OutOfBudget { pub gas_left: u256 }

/// Gas that must remain before a deployment or a run starts.
pub const MIN_GAS_LEFT: u256 = 60_000_000

/// Fail clearly while there is still gas to say so, instead of dying later with
/// an empty revert from a failed `create`.
pub fn require_budget() uses (evm: Evm) {
    let left = evm.gas()
    if left < MIN_GAS_LEFT {
        revert_error(OutOfBudget { gas_left: left })
    }
}

/// Fail loudly, up front, if the sender could run out of ether mid-run.
fn require_funds<H: Harness>(_ calls: u256) uses (evm: Evm) {
    let need = calls * H::Calls::MAX_VALUE
    let have = evm.balance(evm.address()).as_wei()
    if have < need {
        revert_error(Underfunded { have, need })
    }
}

/// A vector of `n` zeros.
pub fn zeros(_ n: u256) -> MemVec<u256> {
    var v = MemVec<u256>::new()
    var i: u256 = 0
    while i < n {
        v.push(0)
        i = i + 1
    }
    v
}

fn world<H: Harness>(_ target: Address, _ cast: Cast, _ sender: u256) -> Env
uses (evm: mut Evm)
{
    Env { target_balance: H::aim_with(target, sender), sender, root: evm.address().word(), cast }
}

/// Deploy a fresh target and make `cfg.steps` random calls, checking the
/// invariants after each. Stops at the first broken invariant.
pub fn fuzz<H: Harness>(_ cfg: Config, _ salt: u256) -> Run uses (evm: mut Evm) {
    fuzz_cast<H>(cfg, salt, Cast::none())
}

/// `fuzz` with several senders: each call is made by the test account or by one
/// of the relays in `cast` (see `Cast::deploy`). The sender of each call is
/// drawn from the seed like everything else.
pub fn fuzz_cast<H: Harness>(_ cfg: Config, _ salt: u256, _ cast: Cast) -> Run
uses (evm: mut Evm)
{
    let len = H::Calls::LEN
    if len == 0 {
        revert_error(EmptyMenu {})
    }
    require_funds<H>(cfg.steps)
    require_budget()
    let target = H::deploy(salt)
    var run = Run {
        broken: 0,
        at: 0,
        executed: 0,
        accepted: 0,
        calls: zeros(len),
        ok: zeros(len),
        steps: MemVec<Step>::new(),
    }

    let root = evm.address().word()
    let pre = H::check_with(target, cast)
    if pre != 0 {
        run.broken = pre
        return run
    }

    var i: u256 = 0
    while i < cfg.steps {
        require_budget()
        var rng = Prng::seeded(Prng::derive(cfg.seed, i))
        let which = rng.below(len)
        // Only a run with relays draws a sender, so single-sender seeds are
        // unchanged.
        var who: u256 = 0
        if cast.count > 0 {
            who = rng.below(cast.count + 1)
        }
        let sender = cast.account(who, root)
        var step = H::Calls::draw_at(which, world<H>(target, cast, sender), mut rng)
        step.variant = which
        step.who = who

        let before = H::snapshot_with(target, cast)
        var via: u256 = 0
        if who != 0 { via = sender }
        let accepted = H::Calls::fire_at(which, target, cfg.gas, step, via)
        run.steps.push(step)
        run.executed = run.executed + 1
        run.calls.set(which as usize, run.calls[which as usize] + 1)
        if accepted {
            run.accepted = run.accepted + 1
            run.ok.set(which as usize, run.ok[which as usize] + 1)
        }

        var broke = H::check_step_with(target, cast, before, step, accepted)
        if broke == 0 {
            broke = H::check_with(target, cast)
        }
        if broke != 0 {
            run.broken = broke
            run.at = i
            return run
        }
        i = i + 1
    }
    run
}

/// Replay concrete `steps` on a fresh target (deployed with `salt`) and return
/// the id of the invariant that broke, or 0 if none did. This is what makes a
/// printed sequence reproducible without the seed.
pub fn replay<H: Harness>(_ steps: MemVec<Step>, _ gas: u256, _ salt: u256) -> u256
uses (evm: mut Evm)
{
    replay_cast<H>(steps, gas, salt, Cast::none())
}

/// `replay` for a multi-sender run: each step's `who` picks its sender from `cast`.
pub fn replay_cast<H: Harness>(
    _ steps: MemVec<Step>,
    _ gas: u256,
    _ salt: u256,
    _ cast: Cast,
) -> u256
uses (evm: mut Evm)
{
    require_funds<H>(steps.len() as u256)
    require_budget()
    let target = H::deploy(salt)
    let root = evm.address().word()
    let pre = H::check_with(target, cast)
    if pre != 0 { return pre }
    var i: usize = 0
    while i < steps.len() {
        require_budget()
        let step = steps[i]
        let before = H::snapshot_with(target, cast)
        var via: u256 = 0
        if step.who != 0 {
            via = cast.account(step.who, root)
        }
        let accepted = H::Calls::fire_at(step.variant, target, gas, step, via)
        let stepped = H::check_step_with(target, cast, before, step, accepted)
        if stepped != 0 {
            return stepped
        }
        let broke = H::check_with(target, cast)
        if broke != 0 { return broke }
        i = i + 1
    }
    0
}

/// `fuzz`, then revert with `InvariantBroken` if an invariant broke. Use this
/// as the body of a test: a clean run returns normally.
pub fn assert_holds<H: Harness>(_ cfg: Config) uses (evm: mut Evm) {
    let seed = cfg.seed
    let run = fuzz<H>(cfg, 0)
    if run.broken != 0 {
        revert_error(
            InvariantBroken { seed, at: run.at, invariant: run.broken },
        )
    }
}
