use ingot::gen::{
    Actor,
    Amount,
    Env,
    Flag,
    Generator,
    Holder,
    MAX_CALL_VALUE,
    Pay,
    Sender,
    SmallWord,
    UpTo,
    Zero,
}
use ingot::cast::Cast
use ingot::prng::{Prng, WORD_MAX}

fn env() -> Env {
    Env { target_balance: 1000, sender: 0x77, root: 0x77, cast: Cast::none() }
}

#[test]
fn zero_and_small_word() {
    var p = Prng::seeded(1)
    assert!(Zero::generate(env(), mut p) == 0)
    var i: u256 = 0
    while i < 100 {
        assert!(SmallWord::generate(env(), mut p) < 4)
        i = i + 1
    }
}

#[test]
fn flag_actor_bounds() {
    var p = Prng::seeded(2)
    var i: u256 = 0
    while i < 100 {
        assert!(Flag::generate(env(), mut p) <= 1)
        let a = Actor::generate(env(), mut p)
        assert!(a >= 0x1000 && a <= 0x1003)
        assert!(UpTo<7>::generate(env(), mut p) <= 7)
        i = i + 1
    }
}

#[test]
fn amount_hits_the_boundaries() {
    var p = Prng::seeded(3)
    var saw_zero = false
    var saw_one = false
    var saw_bal = false
    var saw_below = false
    var saw_above = false
    var saw_max = false
    var i: u256 = 0
    while i < 400 {
        let v = Amount::generate(env(), mut p)
        if v == 0 { saw_zero = true }
        if v == 1 { saw_one = true }
        if v == 1000 {
            saw_bal = true
        }
        if v == 999 {
            saw_below = true
        }
        if v == 1001 {
            saw_above = true
        }
        if v == WORD_MAX {
            saw_max = true
        }
        i = i + 1
    }
    assert!(
        saw_zero && saw_one && saw_bal && saw_below && saw_above && saw_max,
    )
}

#[test]
fn amount_handles_empty_and_full_balance() {
    var p = Prng::seeded(4)
    var i: u256 = 0
    while i < 100 {
        let _ = Amount::generate(
            Env { target_balance: 0, sender: 0x77, root: 0x77, cast: Cast::none() },
            mut p,
        )
        let _ = Amount::generate(
            Env { target_balance: WORD_MAX, sender: 0x77, root: 0x77, cast: Cast::none() },
            mut p,
        )
        i = i + 1
    }
}

#[test]
fn pay_is_bounded_and_hits_its_boundaries() {
    var p = Prng::seeded(5)
    var saw_zero = false
    var saw_one = false
    var saw_max = false
    var i: u256 = 0
    while i < 300 {
        let v = Pay::generate(env(), mut p)
        assert!(v <= MAX_CALL_VALUE)
        if v == 0 { saw_zero = true }
        if v == 1 { saw_one = true }
        if v == MAX_CALL_VALUE {
            saw_max = true
        }
        i = i + 1
    }
    assert!(saw_zero && saw_one && saw_max)
}

#[test]
fn pay_ignores_the_world() {
    var a = Prng::seeded(8)
    var b = Prng::seeded(8)
    var i: u256 = 0
    while i < 50 {
        assert!(
            Pay::generate(
                    Env { target_balance: 0, sender: 0x77, root: 0x77, cast: Cast::none() },
                    mut a,
                )
                == Pay::generate(
                    Env { target_balance: 12345, sender: 0x77, root: 0x77, cast: Cast::none() },
                    mut b,
                ),
        )
        i = i + 1
    }
}

#[test]
fn sender_and_holder() {
    var p = Prng::seeded(6)
    assert!(Sender::generate(env(), mut p) == 0x77)
    var saw_zero = false
    var saw_sender = false
    var saw_actor = false
    var i: u256 = 0
    while i < 300 {
        let h = Holder::generate(env(), mut p)
        if h == 0 {
            saw_zero = true
        } else if h == 0x77 {
            saw_sender = true
        } else {
            assert!(h >= 0x1000 && h <= 0x1003)
            saw_actor = true
        }
        i = i + 1
    }
    assert!(saw_zero && saw_sender && saw_actor)
}

fn in_holder_domain(_ v: u256) -> bool {
    v == 0 || v == 0x77 || (v >= 0x1000 && v <= 0x1003)
}

/// Shrinking must never leave what the generator can produce.
#[test]
fn simpler_values_stay_inside_the_generators_domain() {
    let domain = [0, 0x77, 0x1000, 0x1001, 0x1002, 0x1003]
    var i: usize = 0
    while i < 6 {
        var a: u256 = 0
        while a < 3 {
            assert!(in_holder_domain(Holder::simpler(env(), domain[i], a)))
            assert!(Sender::simpler(env(), 0x77, a) == 0x77)
            a = a + 1
        }
        i = i + 1
    }
}

/// Repeatedly taking the first different simpler value reaches a fixed point.
#[test]
fn simplifying_terminates() {
    var v: u256 = 0x1003
    var steps: u256 = 0
    var moved = true
    while moved && steps < 20 {
        moved = false
        var a: u256 = 0
        while a < 3 && !moved {
            let n = Holder::simpler(env(), v, a)
            if n != v {
                v = n
                moved = true
            }
            a = a + 1
        }
        steps = steps + 1
    }
    assert!(!moved)
    assert!(v == 0)
}

#[test]
fn actor_simplifies_only_to_actors() {
    var k: u256 = 0
    while k < 4 {
        var a: u256 = 0
        while a < 3 {
            let n = Actor::simpler(env(), 0x1000 + k, a)
            assert!(n >= 0x1000 && n <= 0x1003 && n <= 0x1000 + k)
            a = a + 1
        }
        k = k + 1
    }
}
